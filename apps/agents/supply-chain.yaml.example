apiVersion: apps/v1
kind: Deployment
metadata:
  name: supply-chain
  namespace: agents
  labels:
    app: supply-chain
    system: magic-cake
spec:
  replicas: 1
  selector:
    matchLabels:
      app: supply-chain
  template:
    metadata:
      labels:
        app: supply-chain
    spec:
      imagePullSecrets:
      - name: artifact-registry
      containers:
      - name: supply-chain
        # TODO: Replace YOUR_REGION and YOUR_PROJECT_ID with values from LOCAL.md
        image: YOUR_REGION-docker.pkg.dev/YOUR_PROJECT_ID/k8s-lab/supply-chain:latest
        ports:
        - containerPort: 8002
          name: http
        envFrom:
        - configMapRef:
            name: agent-config
        resources:
          requests:
            memory: "512Mi"
            cpu: "250m"
          limits:
            memory: "1Gi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /health
            port: 8002
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /health
            port: 8002
          initialDelaySeconds: 10
          periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: supply-chain
  namespace: agents
  labels:
    app: supply-chain
spec:
  selector:
    app: supply-chain
  ports:
  - port: 8002
    targetPort: 8002
    name: http
  type: ClusterIP
