apiVersion: apps/v1
kind: Deployment
metadata:
  name: commerce
  namespace: agents
  labels:
    app: commerce
    system: magic-cake
spec:
  replicas: 1
  selector:
    matchLabels:
      app: commerce
  template:
    metadata:
      labels:
        app: commerce
    spec:
      containers:
      - name: commerce
        # TODO: Replace YOUR_REGION and YOUR_PROJECT_ID with values from LOCAL.md
        image: YOUR_REGION-docker.pkg.dev/YOUR_PROJECT_ID/k8s-lab/commerce:latest
        ports:
        - containerPort: 8001
          name: http
        envFrom:
        - configMapRef:
            name: agent-config
        resources:
          requests:
            memory: "512Mi"
            cpu: "250m"
          limits:
            memory: "1Gi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /health
            port: 8001
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /health
            port: 8001
          initialDelaySeconds: 10
          periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: commerce
  namespace: agents
  labels:
    app: commerce
spec:
  selector:
    app: commerce
  ports:
  - port: 8001
    targetPort: 8001
    name: http
  type: ClusterIP
